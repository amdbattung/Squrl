@typeparam TItem
@typeparam TValue
@implements IAsyncDisposable
@inject IJSRuntime Js

<div @ref="_containerElement"
     class="searchable-select">
    <div class="searchable-select-input-wrapper">
        
        <input @ref="_input"
               class="form-control sis-input"
               value="@_searchText"
               placeholder="@Placeholder"
               autocomplete="off"
               @onfocus="Open"
               @onclick="Open"
               @oninput="OnSearchInput"/>

        @if (_isLoading)
        {
            <span class="searchable-select-spinner">
                Loading...
            </span>
        }
    </div>

    @if (_isOpen)
    {
        <div class="searchable-select-dropdown">
            @if (AllowNull)
            {
                <button type="button"
                        class="searchable-select-option null-option"
                        @onclick="SelectNull">
                    <span>
                        @NullText
                    </span>
                    
                    @if (EqualityComparer<TValue?>.Default.Equals(
                        Value,
                        default))
                    {
                        <span>✓</span>
                    }
                </button>
            }

            @if (_items.Count == 0 && !_isLoading)
            {
                <div class="searchable-select-empty">
                    No results found.
                </div>
            }
            else
            {
                @foreach (TItem item in _items)
                {
                    TValue itemValue = GetValue(item);

                    <button type="button"
                            class="searchable-select-option @(IsSelected(itemValue) ? "selected" : "")"
                            @key="item"
                            @onclick="() => SelectItem(item)">

                        <span>
                            @GetText(item)
                        </span>

                        @if (IsSelected(itemValue))
                        {
                            <span>✓</span>
                        }

                    </button>
                }

                @if (_hasMore)
                {
                    <div @ref="_loadMoreSentinel"
                         class="searchable-select-sentinel">
                    </div>
                }


                @if (_isLoading && _items.Count > 0)
                {
                    <div class="searchable-select-loading">
                        Loading more...
                    </div>
                }

                @if (!_hasMore && _items.Count > 0)
                {
                    <div class="searchable-select-end">
                        End of results
                    </div>
                }
            }
        </div>
    }

</div>

@code {
    private readonly List<TItem> _items = [];
    
    private ElementReference _input;
    private ElementReference _containerElement;
    private ElementReference _loadMoreSentinel;
    
    private DotNetObjectReference<InputSearchableSelect<TItem, TValue>>? _dotNetReference;
    
    private CancellationTokenSource? _searchCancellation;
    
    // Text displayed in the input.
    private string _searchText = string.Empty;
    
    // Actual search query sent to the backend.
    private string _searchQuery = string.Empty;

    private bool _userHasSelectedValue;
    private int _pageNumber = 1;
    private bool _hasMore;
    
    private bool _isLoading;
    private bool _isOpen;
    
    private bool _jsInitialized;
    private bool _disposed;

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter, EditorRequired]
    public Func<
        string?,
        int,
        int,
        CancellationToken,
        Task<PagedResult<TItem>>
    > LoadItems { get; set; }

    [Parameter, EditorRequired]
    public Func<TItem, TValue> GetValue { get; set; }

    [Parameter, EditorRequired]
    public Func<TItem, string> GetText { get; set; }

    [Parameter]
    public string? InitialValueText { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Select...";

    [Parameter]
    public int PageSize { get; set; } = 10;

    [Parameter]
    public bool AllowNull { get; set; }

    [Parameter]
    public string NullText { get; set; } = "Select...";

    protected override async Task OnInitializedAsync()
    {
        await LoadFirstPage();
    }

    protected override void OnParametersSet()
    {
        if (!_userHasSelectedValue &&
            Value is not null &&
            !string.IsNullOrWhiteSpace(InitialValueText))
        {
            _searchText =
                InitialValueText;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }
        
        if (firstRender)
        {
            _dotNetReference = DotNetObjectReference.Create(this);

            await Js.InvokeVoidAsync(
                "infiniteSelect.initialize",
                _containerElement,
                _dotNetReference);

            _jsInitialized = true;
        }

        // The sentinel only exists while:
        // _isOpen == true
        // _hasMore == true
        // _items.Count > 0
        // Attach the observer after the sentinel has actually been rendered.
        if (_isOpen &&
            _hasMore &&
            _items.Count > 0)
        {
            await Js.InvokeVoidAsync(
                "infiniteSelect.observe",
                _containerElement,
                _loadMoreSentinel,
                _dotNetReference);
        }
    }

    private async Task Open()
    {
        if (_disposed)
        {
            return;
        }

        if (_isOpen)
        {
            return;
        }

        _isOpen = true;

        // Do NOT reset pagination here.
        // If the user selected an item, reopening should
        // preserve the existing loaded items and pagination.
        await InvokeAsync(
            StateHasChanged);
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        if (_disposed)
        {
            return;
        }

        string newText =
            args.Value?.ToString() ?? string.Empty;

        // Don't perform a search if the text hasn't changed.
        if (string.Equals(
            _searchText,
            newText,
            StringComparison.Ordinal))
        {
            return;
        }


        // The user is typing.
        // Therefore, the displayed text and backend
        // query are the same.
        _searchText =
            newText;

        _searchQuery =
            newText;

        _userHasSelectedValue =
            false;

        // Cancel previous search.
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = new CancellationTokenSource();
        
        CancellationToken token = _searchCancellation.Token;
        
        try
        {
            // Debounce.
            await Task.Delay(300, token);
            await LoadFirstPage(token);
        }
        catch (OperationCanceledException)
        {
            // Expected when the user continues typing.
        }
    }

    private async Task LoadFirstPage(CancellationToken cancellationToken = default)
    {
        if (_disposed)
        {
            return;
        }

        _pageNumber = 1;
        _items.Clear();
        _hasMore = true;

        await LoadPage(cancellationToken);
    }

    private async Task LoadPage(CancellationToken cancellationToken = default)
    {
        if (_disposed)
        {
            return;
        }

        if (_isLoading)
        {
            return;
        }

        _isLoading = true;

        await InvokeAsync(StateHasChanged);

        try
        {
            // IMPORTANT: Send _searchQuery, not _searchText.
            PagedResult<TItem> result =
                await LoadItems(
                    _searchQuery,
                    _pageNumber,
                    PageSize,
                    cancellationToken);

            // Prevent stale/canceled results from being added.
            cancellationToken.ThrowIfCancellationRequested();

            int previousCount = _items.Count;

            _items.AddRange(result.Items);
            _hasMore = result.HasMore;
        }
        catch (OperationCanceledException)
        {
            
        }
        finally
        {
            _isLoading = false;

            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    [JSInvokable]
    public async Task LoadNextPage()
    {
        if (_disposed)
        {
            return;
        }

        if (_isLoading)
        {
            return;
        }

        if (!_hasMore)
        {
            return;
        }

        int nextPage = _pageNumber + 1;

        _isLoading = true;

        await InvokeAsync(StateHasChanged);

        try
        {
            // IMPORTANT: Use _searchQuery here.
            PagedResult<TItem> result =
                await LoadItems(
                    _searchQuery,
                    nextPage,
                    PageSize,
                    CancellationToken.None);

            // Only update the page number after successful loading.
            _pageNumber = nextPage;

            int previousCount = _items.Count;

            _items.AddRange(result.Items);

            _hasMore = result.HasMore;
        }
        catch (Exception exception)
        {
            // Ignored
        }
        finally
        {
            _isLoading = false;


            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task SelectItem(TItem item)
    {
        if (_disposed)
        {
            return;
        }

        TValue value = GetValue(item);
        
        _searchCancellation?.Cancel();
        
        Value = value;


        // This only changes what is displayed. It does NOT change _searchQuery.
        _searchText = GetText(item);

        _userHasSelectedValue = true;
        
        _isOpen =
            false;
        
        await ValueChanged.InvokeAsync(value);

        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectNull()
    {
        if (_disposed)
        {
            return;
        }
        
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = new CancellationTokenSource();
        
        Value = default;
        
        _searchText = string.Empty;
        _searchQuery = string.Empty;
        _userHasSelectedValue = true;

        _isOpen = false;
        
        await LoadFirstPage(_searchCancellation.Token);
        
        await ValueChanged.InvokeAsync(default);
        
        _isOpen = false;


        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task CloseDropdown()
    {
        if (_disposed)
        {
            return;
        }

        if (!_isOpen)
        {
            return;
        }

        _isOpen = false;

        await InvokeAsync(StateHasChanged);
    }

    private bool IsSelected(TValue value)
    {
        return EqualityComparer<TValue>
            .Default
            .Equals(Value, value);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;

        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = null;

        if (_jsInitialized)
        {
            try
            {
                await Js.InvokeVoidAsync(
                    "infiniteSelect.dispose",
                    _containerElement);
            }
            catch (JSDisconnectedException)
            {
                // Circuit disconnected.
            }
            catch (InvalidOperationException)
            {
                // JS unavailable during disposal.
            }
        }

        _dotNetReference?.Dispose();
        _dotNetReference = null;
    }


    public sealed class PagedResult<T>
    {
        public IReadOnlyCollection<T> Items { get; init; } = [];
        public bool HasMore { get; init; }
    }
}