@page "/uoms"
@rendermode InteractiveServer
@implements IDisposable
@inject IUomService UomService
@inject NavigationManager Navigation

<h1>Unit of Measures</h1>

<input class="form-control"
       placeholder="Search UOM..."
       value="@_searchInput"
       @oninput="OnSearchInput" />

<button class="btn btn-primary" @onclick="HandleAddUomButtonClick">+ Add UOM</button>

<QuickGrid @ref="_grid"
           TGridItem="GetUomDto"
           ItemsProvider="LoadUoms"
           Pagination="@_pagination">
    <PropertyColumn Property="u => u.Name" />
    <PropertyColumn Property="u => u.Code" />
    <PropertyColumn Property="u => u.Description" />
    <TemplateColumn Title="Actions">
        <button class="btn btn-secondary"
                @onclick="@(() => HandleEditUomButtonClick(context.Id ?? Guid.Empty))">
            Edit UOM
        </button>
        <button class="btn btn-danger"
                @onclick="@(() => HandleDeleteUomButtonClick(context.Id ?? Guid.Empty))">
            Delete UOM
        </button>
    </TemplateColumn>
</QuickGrid>

<Paginator State="_pagination" />

<select @bind="_pagination.ItemsPerPage">
    <option>5</option>
    <option>10</option>
    <option>15</option>
    <option>20</option>
    <option>25</option>
</select>

@if (_errorMessages.Count > 0)
{
    <div class="alert alert-danger mt-3" role="alert">
        <ul class="mb-0">
            @foreach (string error in _errorMessages)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@code {
    private QuickGrid<GetUomDto>? _grid;
    
    private readonly PaginationState _pagination = new()
    {
        ItemsPerPage = 10
    };
    
    private string _searchInput = string.Empty;
    private string _search = string.Empty;

    private CancellationTokenSource? _debounceCts;
    private int _searchVersion;
    private bool _isDeleting;
    private bool _disposed;
    
    private IReadOnlyList<string> _errorMessages = [];

    private async ValueTask<GridItemsProviderResult<GetUomDto>> LoadUoms(
        GridItemsProviderRequest<GetUomDto> request)
    {
        try
        {
            int pageSize = request.Count ?? _pagination.ItemsPerPage;
            int pageNumber = request.StartIndex / pageSize + 1;

            Result<GetManyUomsDto> result = await UomService.GetManyUomsAsync(
                _search,
                pageNumber,
                pageSize,
                cancellationToken: request.CancellationToken);

            if (!result.IsSuccess || result.Value?.Uoms is null)
            {
                _errorMessages = result.Errors;

                return GridItemsProviderResult.From(
                    Array.Empty<GetUomDto>(),
                    0);
            }

            _errorMessages = [];

            return GridItemsProviderResult.From(
                result.Value.Uoms?.ToList() ?? [],
                result.Value.TotalCount);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            _errorMessages = ["An unexpected error occurred while loading UOMs."];

            return GridItemsProviderResult.From(
                Array.Empty<GetUomDto>(),
                0);
        }
    }
    
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchInput = e.Value?.ToString() ?? string.Empty;

        // Invalidate any previous pending search.
        int version = ++_searchVersion;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();

        CancellationTokenSource cts = new();
        _debounceCts = cts;

        try
        {
            await Task.Delay(500, cts.Token);

            if (_disposed ||
                cts.IsCancellationRequested ||
                version != _searchVersion)
            {
                return;
            }

            string newSearch = _searchInput.Trim();

            if (string.Equals(_search, newSearch, StringComparison.Ordinal))
            {
                return;
            }

            _search = newSearch;
            _errorMessages = [];

            if (_pagination.CurrentPageIndex != 0)
            {
                await _pagination.SetCurrentPageIndexAsync(0);
            }
            else if (_grid is not null)
            {
                await _grid.RefreshDataAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when another keystroke arrives.
        }
        finally
        {
            if (ReferenceEquals(_debounceCts, cts))
            {
                _debounceCts = null;
            }

            cts.Dispose();
        }
    }

    private void HandleAddUomButtonClick()
    {
        Navigation.NavigateTo("/uoms/new");
    }
    
    private void HandleEditUomButtonClick(Guid uomId)
    {
        Navigation.NavigateTo($"/uoms/{uomId}/edit");
    }
    
    private async Task HandleDeleteUomButtonClick(Guid uomId)
    {
        if (_isDeleting)
        {
            return;
        }

        _isDeleting = true;
        _errorMessages = [];

        try
        {
            Result<GetUomDto> result = await UomService.DeleteUomAsync(uomId);

            if (!result.IsSuccess)
            {
                _errorMessages = result.Errors;
                return;
            }

            if (_grid is not null)
            {
                await _grid.RefreshDataAsync();
            }
        }
        catch (Exception)
        {
            _errorMessages = ["An unexpected error occurred while deleting UOM."];
        }
        finally
        {
            _isDeleting = false;
        }
    }
    
    public void Dispose()
    {
        _disposed = true;
        _searchVersion++;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = null;
    }
}