@page "/uoms"
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject IUomService UomService
@inject NavigationManager Navigation

<h1>Unit of Measures</h1>

<input class="form-control"
       @bind="_searchInput"
       @bind:event="oninput"
       @bind:after="SearchAsync" />

<button class="btn btn-primary" @onclick="HandleAddUomButtonClick">+ Add UOM</button>

<QuickGrid @ref="_grid"
    TGridItem="GetUomDto"
    ItemsProvider="LoadUoms"
    Pagination="@_pagination">
    <PropertyColumn Property="u => u.Name" />
    <PropertyColumn Property="u => u.Code" />
    <PropertyColumn Property="u => u.Description" />
    <TemplateColumn Title="Actions">
        <button class="btn btn-secondary"
                @onclick="@(() => HandleEditUomButtonClick(context.Id ?? Guid.Empty))">
            Edit UOM
        </button>
        <button class="btn btn-danger"
                @onclick="@(() => HandleDeleteUomButtonClick(context.Id ?? Guid.Empty))">
            Delete UOM
        </button>
    </TemplateColumn>
</QuickGrid>

<Paginator State="_pagination" />

<select class="form-select mt-3"
        style="width:120px"
        @bind="_pagination.ItemsPerPage">
    <option>5</option>
    <option>10</option>
    <option>15</option>
    <option>20</option>
    <option>25</option>
</select>

@code {
    private QuickGrid<GetUomDto>? _grid;
    
    private readonly PaginationState _pagination = new()
    {
        ItemsPerPage = 10
    };
    
    private string _searchInput = "";
    private string _search = "";
    private CancellationTokenSource? _debounceCts;
    
    // private string? _errorMessage;

    private async ValueTask<GridItemsProviderResult<GetUomDto>> LoadUoms(
        GridItemsProviderRequest<GetUomDto> request)
    {
        try
        {
            int pageSize = request.Count ?? _pagination.ItemsPerPage;

            int pageNumber = (request.StartIndex / pageSize) + 1;

            Result<GetManyUomsDto> result =
                await UomService.GetManyUomsAsync(
                    _search,
                    pageNumber,
                    pageSize);

            if (!result.IsSuccess || result.Value is null)
            {
                // errorMessage = string.Join(", ", result.Errors);

                return GridItemsProviderResult.From(
                    Array.Empty<GetUomDto>(),
                    0);
            }

            // errorMessage = null;

            return GridItemsProviderResult.From(
                result.Value?.Uoms?.ToList() ?? [],
                result.Value?.TotalCount ?? 0);
        }
        catch (Exception ex)
        {
            // errorMessage = ex.Message;

            return GridItemsProviderResult.From(
                Array.Empty<GetUomDto>(),
                0);
        }
    }
    
    private async Task SearchAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();

        _debounceCts = new();
        CancellationToken token = _debounceCts.Token;

        try
        {
            await Task.Delay(500, token);

            // Apply the search only after the delay
            _search = _searchInput;

            await _pagination.SetCurrentPageIndexAsync(0);

            if (_grid is not null)
            {
                await _grid.RefreshDataAsync();
            }
        }
        catch (OperationCanceledException) { }
    }

    private void HandleAddUomButtonClick()
    {
        Navigation.NavigateTo("/uoms/new");
    }
    
    private void HandleEditUomButtonClick(Guid uomId)
    {
        Navigation.NavigateTo($"/uoms/{uomId}/edit");
    }
    
    private async Task HandleDeleteUomButtonClick(Guid uomId)
    {
        Result<GetUomDto> result = await UomService.DeleteUomAsync(uomId);

        if (result.IsSuccess && _grid is not null)
        {
            await _grid.RefreshDataAsync();
        }
    }
}