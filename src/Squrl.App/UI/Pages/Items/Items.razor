@page "/items"
@rendermode InteractiveServer
@implements IDisposable
@inject IInventoryService InventoryService
@inject IUomService UomService
@inject NavigationManager Navigation

<h1>Items</h1>

<input class="form-control"
       placeholder="Search item..."
       value="@_searchInput"
       @oninput="OnSearchInput" />

<button class="btn btn-primary" @onclick="HandleAddItemButtonClick">+ Add Item</button>

<QuickGrid @ref="_grid"
           TGridItem="GetItemDto"
           ItemsProvider="LoadItems"
           Pagination="@_pagination">
    <PropertyColumn Property="i => i.Name" />
    <PropertyColumn Property="i => i.Description" />
    <TemplateColumn Title="Onhand">
        @(context.Quantity.HasValue
            ? ToStringFormatters.FormatDecimal(context.Quantity.Value)
            : "")
    </TemplateColumn>
    <TemplateColumn Title="UOM">
        @(_uomCache.TryGetValue(context.UomId ?? Guid.Empty, out string? uom)
            ? uom
            : "")
    </TemplateColumn>
    <TemplateColumn Title="List Price">
        @(context.ListPrice.HasValue
            ? ToStringFormatters.FormatDecimal(context.ListPrice.Value)
            : "")
    </TemplateColumn>
    <TemplateColumn Title="Retail Price">
        @(context.RetailPrice.HasValue
            ? ToStringFormatters.FormatDecimal(context.RetailPrice.Value)
            : "")
    </TemplateColumn>
    <TemplateColumn Title="Cost Price">
        @(context.CostPrice.HasValue
            ? ToStringFormatters.FormatDecimal(context.CostPrice.Value)
            : "")
    </TemplateColumn>
    <TemplateColumn Title="Low Stock Threshold">
        @(context.LowQuantityAlertThreshold.HasValue
            ? ToStringFormatters.FormatDecimal(context.LowQuantityAlertThreshold.Value)
            : "")
    </TemplateColumn>
    <TemplateColumn Title="Location(s)">
        @string.Join(", ", context.Locations ?? Array.Empty<string>())
    </TemplateColumn>
    <TemplateColumn Title="Actions">
        <button class="btn btn-secondary"
                @onclick="@(() => HandleEditItemButtonClick(context.Id ?? Guid.Empty))">
            Edit
        </button>
        <button class="btn btn-danger"
                disabled="@(_isDeleting)"
                @onclick="@(() => HandleDeleteItemButtonClick(context.Id ?? Guid.Empty))">
            @(_isDeleting ? "Deleting..." : "Delete")
        </button>
    </TemplateColumn>
</QuickGrid>

<Paginator State="@_pagination" />

<select @bind="@_pagination.ItemsPerPage"> 
    <option>5</option> 
    <option>10</option> 
    <option>15</option> 
    <option>20</option> 
    <option>25</option> 
</select>

@if (_errorMessages.Count > 0)
{
    <div class="alert alert-danger mt-3" role="alert">
        <ul class="mb-0">
            @foreach (string error in _errorMessages)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@code {
    private QuickGrid<GetItemDto>? _grid;
    
    private readonly PaginationState _pagination = new()
    {
        ItemsPerPage = 10
    };
    
    private readonly Dictionary<Guid, string> _uomCache = new();
    
    private string _searchInput = string.Empty;
    private string _search = string.Empty;
    
    private readonly Debouncer _debouncer = new();
    
    private bool _isDeleting;
    private bool _disposed;
    
    private IReadOnlyList<string> _errorMessages = [];

    private async ValueTask<GridItemsProviderResult<GetItemDto>> LoadItems(
        GridItemsProviderRequest<GetItemDto> request)
    {
        try
        {
            int pageSize = request.Count ?? _pagination.ItemsPerPage;
            int pageNumber = request.StartIndex / pageSize + 1;

            Result<GetManyItemsDto> result =
                await InventoryService.GetManyItemsAsync(
                    _search,
                    pageNumber,
                    pageSize,
                    cancellationToken: request.CancellationToken);

            if (!result.IsSuccess || result.Value?.Items is null)
            {
                _errorMessages = result.Errors;

                return GridItemsProviderResult.From(
                    Array.Empty<GetItemDto>(),
                    0);
            }
            
            foreach (GetItemDto item in result.Value.Items)
            {
                if (!_uomCache.ContainsKey(item.UomId ?? Guid.Empty))
                {
                    Result<GetUomDto> uom = await UomService.GetUomByIdAsync(item.UomId ?? Guid.Empty);

                    if (uom.IsSuccess)
                    {
                        _uomCache[item.UomId ?? Guid.Empty] = uom.Value?.Code ?? string.Empty;
                    }
                }
            }

            _errorMessages = [];

            return GridItemsProviderResult.From(
                result.Value.Items?.ToList() ?? [],
                result.Value.TotalCount);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            _errorMessages = ["An unexpected error occurred while loading items."];

            return GridItemsProviderResult.From(
                Array.Empty<GetItemDto>(),
                0);
        }
    }
    
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchInput = e.Value?.ToString() ?? string.Empty;

        await _debouncer.DebounceAsync(
            async cancellationToken =>
            {
                cancellationToken.ThrowIfCancellationRequested();
                await ApplyFiltersAsync();
            },
            TimeSpan.FromMilliseconds(500));
    }
    
    private async Task ApplyFiltersAsync()
    {
        string newSearch = _searchInput.Trim();

        bool searchChanged = !string.Equals(
            _search,
            newSearch,
            StringComparison.Ordinal);

        if (!searchChanged && _grid is null)
        {
            return;
        }

        _search = newSearch;
        _errorMessages = [];

        if (_pagination.CurrentPageIndex != 0)
        {
            await _pagination.SetCurrentPageIndexAsync(0);
        }
        else if (_grid is not null)
        {
            await _grid.RefreshDataAsync();
        }
    }

    private void HandleAddItemButtonClick()
    {
        Navigation.NavigateTo("/items/new");
    }
    
    private void HandleEditItemButtonClick(Guid itemId)
    {
        Navigation.NavigateTo($"/items/{itemId}/edit");
    }
    
    private async void HandleDeleteItemButtonClick(Guid itemId)
    {
        if (_isDeleting)
        {
            return;
        }

        _isDeleting = true;
        _errorMessages = [];

        try
        {
            Result<GetItemDto> result = await InventoryService.DeleteItemAsync(itemId);

            if (!result.IsSuccess)
            {
                _errorMessages = result.Errors;
                return;
            }

            if (_grid is not null)
            {
                await _grid.RefreshDataAsync();
            }
        }
        catch (Exception)
        {
            _errorMessages = ["An unexpected error occurred while deleting item."];
        }
        finally
        {
            _isDeleting = false;
        }
    }
    
    public void Dispose()
    {
        _disposed = true;
        _debouncer.Dispose();
    }
}