@page "/items/{ItemId:guid}/edit"
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject NavigationManager Navigation
@inject IInventoryService InventoryService
@inject IUomService UomService
@inject IJSRuntime Js

<h1>Edit Item</h1>

@if (Item is not null)
{
    <EditForm Model="Item" OnValidSubmit="HandleSubmit" FormName="AddItemForm">
        <FluentValidator />
        <div>
            <label>Name</label>
            <InputText @bind-Value="Item.Name" />
            <ValidationMessage For="@(() => Item.Name)" />
        </div>
        <div>
            <label>Description</label>
            <InputText @bind-Value="Item.Description" />
            <ValidationMessage For="@(() => Item.Description)" />
        </div>
        <div>
            <label>Item Photo</label>
            <InputFile
                id="itemPhoto"
                OnChange="@OnPhotoSelected"
                accept="image/jpeg,image/png,image/webp"
                class="form-control" />
        </div>
        @if (!string.IsNullOrWhiteSpace(_photoError))
        {
            <div class="alert alert-danger"> @_photoError </div>
        }
        @if (!string.IsNullOrWhiteSpace(_photoPreviewUrl))
        {
            <div class="mb-3">
                <div class="product-photo-preview">
                    <img src="@_photoPreviewUrl" alt="Product photo preview" />
                </div>
            </div>
        }
        <div>
            <label>UOM</label>
        
            <InputSearchableSelect
                TItem="GetUomDto"
                TValue="Guid?"
                Value="Item.UomId"
                ValueChanged="@(value => Item.UomId = value)"
                InitialValueText="@_initialUomText"
                Placeholder="Select a UOM"
                NullText="Select a UOM"
                AllowNull="true"
                PageSize="10"
                LoadItems="LoadUoms"
                GetValue="@(uom => uom.Id)"
                GetText="@(uom => $"{uom.Name} ({uom.Code})")" />

            <ValidationMessage For="@(() => Item.UomId)" />
        </div>
        <div>
            <label>Quantity</label>
            <InputNumber @bind-Value="Item.Quantity" />
            <ValidationMessage For="@(() => Item.Quantity)" />
        </div>
        <div>
            <label>List Price</label>
            <InputNumber @bind-Value="Item.ListPrice" />
            <ValidationMessage For="@(() => Item.ListPrice)" />
        </div>
        <div>
            <label>Retail Price</label>
            <InputNumber @bind-Value="Item.RetailPrice" />
            <ValidationMessage For="@(() => Item.RetailPrice)" />
        </div>
        <div>
            <label>Cost Price</label>
            <InputNumber @bind-Value="Item.CostPrice" />
            <ValidationMessage For="@(() => Item.CostPrice)" />
        </div>
        <div>
            <label>Low Stock Alert On Or Below</label>
            <InputNumber @bind-Value="Item.LowQuantityAlertThreshold" />
            <ValidationMessage For="@(() => Item.LowQuantityAlertThreshold)" />
        </div>
        
        <hr />

        <h2>Locations</h2>

        @for (int i = 0; i < Item.Locations?.Count; i++)
        {
            int index = i;

            <div class="item-location" @key="index">
                <div>
                    <label hidden>Location @(index + 1)</label>
                    <InputText @bind-Value="Item.Locations[index]"/>
                    <ValidationMessage For="@(() => Item.Locations[index])" />
                </div>

                <button type="button" @onclick="() => RemoveLocation(index)">
                    Remove
                </button>
            </div>
        }

        <button type="button" @onclick="AddLocation">
            +
        </button>
        
        <button type="submit">Submit</button>
    </EditForm>
    
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">
            @_successMessage
        </div>
    }
}
else
{
    <p>Loading...</p>
}

@code {
    private byte[]? _processedPhoto;
    private string? _initialUomText;
    private string? _photoPreviewUrl;
    private string? _successMessage;
    private string? _photoError;
    
    [Parameter]
    public required Guid ItemId { get; set; }
    
    [PersistentState]
    public UpdateItemDto? Item { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        if (Item is null)
        {
            GetItemDto? itemResult = (await InventoryService.GetItemByIdAsync(ItemId)).Value;
            
            if (itemResult is null)
            {
                Navigation.NotFound();
                return;
            }
            
            Item = new()
            {
                Name = itemResult.Name,
                UomId = itemResult.UomId,
                Description = itemResult.Description,
                ListPrice = itemResult.ListPrice,
                RetailPrice = itemResult.RetailPrice,
                CostPrice = itemResult.CostPrice,
                Quantity = itemResult.Quantity,
                LowQuantityAlertThreshold = itemResult.LowQuantityAlertThreshold,
                Locations = itemResult.Locations?.ToList()
            };

            GetUomDto? uom = (await UomService.GetUomByIdAsync(itemResult.UomId ?? Guid.Empty)).Value;
            if (uom is not null)
            {
                _initialUomText = $"{uom.Name} ({uom.Code})";
            }

            if (!string.IsNullOrWhiteSpace(itemResult.Image))
            {
                _photoPreviewUrl = $"/api/images/{itemResult.Image}";
            }
        }
    }
    
    private async Task<InputSearchableSelect<GetUomDto, Guid?>.PagedResult<GetUomDto>>
        LoadUoms(
            string? query,
            int pageNumber,
            int pageSize,
            CancellationToken cancellationToken)
    {
        Result<GetManyUomsDto> result =
            await UomService.GetManyUomsAsync(
                query: query,
                pageNumber: pageNumber,
                pageSize: pageSize,
                cancellationToken: cancellationToken);

        if (!result.IsSuccess || result.Value is null)
        {
            return new()
            {
                Items = [],
                HasMore = false
            };
        }

        GetManyUomsDto payload = result.Value;

        bool hasMore = payload.PageNumber * payload.PageSize < payload.TotalCount;

        return new()
        {
            Items = payload.Uoms ?? [],
            HasMore = hasMore
        };
    }
    
    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        _photoError = null;
        _photoPreviewUrl = null;
        _processedPhoto = null;

        try
        {
            BrowserImageResult? result = await Js.InvokeAsync<BrowserImageResult?>(
                "productImage.process",
                "itemPhoto",
                800,
                0.85);

            if (result is null || result.Bytes.Length == 0)
            {
                _photoError = "Unable to process the image.";
                return;
            }

            _processedPhoto = result.Bytes;

            _photoPreviewUrl = $"data:{result.MimeType};base64,{Convert.ToBase64String(result.Bytes)}";
        }
        catch (JSException ex)
        {
            _photoError = "Something went wrong while processing the image.";
            _processedPhoto = null;
            _photoPreviewUrl = null;
        }
        catch (Exception)
        {
            _photoError = "Something went wrong while processing the image.";
            _processedPhoto = null;
            _photoPreviewUrl = null;
        }
    }
    
    private void AddLocation()
    {
        Item?.Locations?.Add(string.Empty);
    }

    private void RemoveLocation(int index)
    {
        if (index >= 0 && index < Item?.Locations?.Count)
        {
            Item.Locations.RemoveAt(index);
        }
    }
    
    private async Task HandleSubmit()
    {
        if (Item is not null)
        {
            await using MemoryStream? photoStream = _processedPhoto is not null
                ? new MemoryStream(_processedPhoto, writable: false)
                : null;
            
            Result<GetItemDto> result = await InventoryService.UpdateItemAsync(ItemId, Item, photoStream);

            if (result.IsSuccess)
            {
                _successMessage = $"Item {result.Value?.Name} successfully updated";
            }
            else
            {
                _successMessage = null;
            }
        }
    }
    
    private sealed class BrowserImageResult
    {
        public byte[] Bytes { get; set; } = [];
        public string MimeType { get; set; } = "";
    }
}