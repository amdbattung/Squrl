@page "/items/new"
@rendermode InteractiveServer
@inject IInventoryService InventoryService
@inject IUomService UomService
@inject IJSRuntime Js

<h1>Add Item</h1>

<EditForm Model="_item" OnValidSubmit="HandleSubmit" FormName="AddItemForm">
    <FluentValidator />
    <div>
        <label>Name</label>
        <InputText @bind-Value="_item.Name" />
        <ValidationMessage For="@(() => _item.Name)" />
    </div>
    <div>
        <label>Description</label>
        <InputText @bind-Value="_item.Description" />
        <ValidationMessage For="@(() => _item.Description)" />
    </div>
    <div>
        <label>Item Photo</label>
        <InputFile
            id="itemPhoto"
            OnChange="@OnPhotoSelected"
            accept="image/jpeg,image/png,image/webp"
            class="form-control" />
    </div>
    @if (!string.IsNullOrWhiteSpace(_photoError))
    {
        <div class="alert alert-danger"> @_photoError </div>
    }
    @if (!string.IsNullOrWhiteSpace(_photoPreviewUrl))
    {
        <div class="mb-3">
            <div class="product-photo-preview">
                <img src="@_photoPreviewUrl" alt="Product photo preview" />
            </div>
        </div>
    }
    <div>
        <label>UOM</label>
        <InputSelect @bind-Value="_item.UomId">
            <option value="">Select a UOM</option>
            @if (UomSelect != null)
            {
                foreach (GetUomDto uom in UomSelect)
                {
                    <option value="@uom.Id">@($"{uom.Name} ({uom.Code})")</option>
                }
            }
        </InputSelect>
        <ValidationMessage For="@(() => _item.UomId)" />
    </div>
    <div>
        <label>Starting Onhand Quantity</label>
        <InputNumber @bind-Value="_item.Quantity" />
        <ValidationMessage For="@(() => _item.Quantity)" />
    </div>
    <div>
        <label>Low Stock Alert On Or Below</label>
        <InputNumber @bind-Value="_item.LowQuantityAlertThreshold" />
        <ValidationMessage For="@(() => _item.LowQuantityAlertThreshold)" />
    </div>
    <button type="submit">Submit</button>
</EditForm>

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success">
        @_successMessage
    </div>
}

@code {
    private CreateItemDto _item = new()
    {
        Quantity = 0m,
        Locations = new List<string>()
    };
    private byte[]? _processedPhoto;
    private string? _photoPreviewUrl;
    private string? _successMessage;
    private string? _photoError;
    
    [PersistentState]
    public IReadOnlyCollection<GetUomDto>? UomSelect { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UomSelect is null)
        {
            Result<GetManyUomsDto> result = await UomService.GetManyUomsAsync();
            UomSelect = result.Value?.Uoms ?? Array.Empty<GetUomDto>();
        }
    }
    
    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        _photoError = null;
        _photoPreviewUrl = null;
        _processedPhoto = null;

        try
        {
            BrowserImageResult? result = await Js.InvokeAsync<BrowserImageResult?>(
                "productImage.process",
                "itemPhoto",
                800,
                0.85);

            if (result is null || result.Bytes.Length == 0)
            {
                _photoError = "Unable to process the image.";
                return;
            }

            _processedPhoto = result.Bytes;

            _photoPreviewUrl = $"data:{result.MimeType};base64,{Convert.ToBase64String(result.Bytes)}";
        }
        catch (JSException ex)
        {
            _photoError = "Something went wrong while processing the image.";
            _processedPhoto = null;
            _photoPreviewUrl = null;
        }
        catch (Exception)
        {
            _photoError = "Something went wrong while processing the image.";
            _processedPhoto = null;
            _photoPreviewUrl = null;
        }
    }

    private async Task HandleSubmit()
    {
        await using MemoryStream? photoStream = _processedPhoto is not null
            ? new MemoryStream(_processedPhoto, writable: false)
            : null;
        
        Result<GetItemDto> result = await InventoryService.CreateItemAsync(_item, photoStream);

        if (result.IsSuccess)
        {
            _item = new()
            {
                Quantity = 0m,
                Locations = new List<string>()
            };
            
            _processedPhoto = null;
            _photoPreviewUrl = null;
            _photoError = null;

            _successMessage = $"Item {result.Value?.Name} successfully added";
        }
        else
        {
            _successMessage = null;
        }
    }

    private sealed class BrowserImageResult
    {
        public byte[] Bytes { get; set; } = [];
        public string MimeType { get; set; } = "";
    }
}