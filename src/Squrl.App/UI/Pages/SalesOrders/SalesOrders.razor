@page "/sos"
@rendermode InteractiveServer
@implements IDisposable
@inject ISalesOrderService SalesOrderService
@inject NavigationManager Navigation

<h1>Sales Orders</h1>

<input class="form-control"
       placeholder="Search invoice no. or customer..."
       value="@_searchInput"
       @oninput="OnSearchInput" />

<button class="btn btn-primary" @onclick="HandleAddSalesOrderButtonClick">+ New SO</button>

<QuickGrid @ref="_grid"
           TGridItem="GetSalesOrderDto"
           ItemsProvider="LoadSalesOrders"
           Pagination="@_pagination">
    <PropertyColumn Title="Sales Order" Property="s => s.Id" />
    <PropertyColumn Title="Invoice" Property="s => s.InvoiceNumber" />
    <PropertyColumn Property="s => s.Customer" />
    <TemplateColumn Title="Date Ordered">
        @context.DateOrdered?.InZone(_userTimeZone).Date.ToDateOnly().ToString("dd MMM yyyy")
    </TemplateColumn>
    <TemplateColumn Title="Actions">
        <button class="btn btn-secondary"
                @onclick="@(() => HandleEditSalesOrderButtonClick(context.Id ?? Guid.Empty))">
            Edit
        </button>
        <button class="btn btn-danger"
                @onclick="@(() => HandleCancelSalesOrderButtonClick(context.Id ?? Guid.Empty))">
            Cancel
        </button>
    </TemplateColumn>
</QuickGrid>

<Paginator State="@_pagination" />

<select @bind="@_pagination.ItemsPerPage"> 
    <option>5</option> 
    <option>10</option> 
    <option>15</option> 
    <option>20</option> 
    <option>25</option> 
</select>

@if (_errorMessages.Count > 0)
{
    <div class="alert alert-danger mt-3" role="alert">
        <ul class="mb-0">
            @foreach (string error in _errorMessages)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@code {
    private QuickGrid<GetSalesOrderDto>? _grid;
    
    private readonly PaginationState _pagination = new()
    {
        ItemsPerPage = 10
    };
    
    private readonly DateTimeZone _userTimeZone = DateTimeZoneProviders.Tzdb.GetSystemDefault();
    
    private string _searchInput = string.Empty;
    private string _search = string.Empty;

    private CancellationTokenSource? _debounceCts;
    private int _searchVersion;
    private bool _isCanceling;
    private bool _disposed;
    
    private IReadOnlyList<string> _errorMessages = [];
    
    private async ValueTask<GridItemsProviderResult<GetSalesOrderDto>> LoadSalesOrders(
        GridItemsProviderRequest<GetSalesOrderDto> request)
    {
        try
        {
            int pageSize = request.Count ?? _pagination.ItemsPerPage;
            int pageNumber = request.StartIndex / pageSize + 1;

            Result<GetManySalesOrdersDto> result =
                await SalesOrderService.GetManySalesOrdersAsync(
                    _search,
                    pageNumber:  pageNumber,
                    pageSize: pageSize,
                    cancellationToken: request.CancellationToken);

            if (!result.IsSuccess || result.Value?.SalesOrders is null)
            {
                _errorMessages = result.Errors;

                return GridItemsProviderResult.From(
                    Array.Empty<GetSalesOrderDto>(),
                    0);
            }

            _errorMessages = [];

            return GridItemsProviderResult.From(
                result.Value.SalesOrders?.ToList() ?? [],
                result.Value.TotalCount);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            _errorMessages = ["An unexpected error occurred while loading sales orders."];

            return GridItemsProviderResult.From(
                Array.Empty<GetSalesOrderDto>(),
                0);
        }
    }
    
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchInput = e.Value?.ToString() ?? string.Empty;

        // Invalidate any previous pending search.
        int version = ++_searchVersion;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();

        CancellationTokenSource cts = new();
        _debounceCts = cts;

        try
        {
            await Task.Delay(500, cts.Token);

            if (_disposed ||
                cts.IsCancellationRequested ||
                version != _searchVersion)
            {
                return;
            }

            string newSearch = _searchInput.Trim();

            if (string.Equals(_search, newSearch, StringComparison.Ordinal))
            {
                return;
            }

            _search = newSearch;
            _errorMessages = [];

            if (_pagination.CurrentPageIndex != 0)
            {
                await _pagination.SetCurrentPageIndexAsync(0);
            }
            else if (_grid is not null)
            {
                await _grid.RefreshDataAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when another keystroke arrives.
        }
        finally
        {
            if (ReferenceEquals(_debounceCts, cts))
            {
                _debounceCts = null;
            }

            cts.Dispose();
        }
    }
    
    private void HandleAddSalesOrderButtonClick()
    {
        Navigation.NavigateTo("/sos/new");
    }
    
    private void HandleEditSalesOrderButtonClick(Guid salesOrderId)
    {
        Navigation.NavigateTo($"/sos/{salesOrderId}/edit");
    }
    
    private async Task HandleCancelSalesOrderButtonClick(Guid salesOrderId)
    {
        if (_isCanceling)
        {
            return;
        }

        _isCanceling = true;
        _errorMessages = [];

        try
        {
            Result<GetSalesOrderDto> result = await SalesOrderService
                .DeleteSalesOrderAsync(salesOrderId);

            if (!result.IsSuccess)
            {
                _errorMessages = result.Errors;
                return;
            }

            if (_grid is not null)
            {
                await _grid.RefreshDataAsync();
            }
        }
        catch (Exception)
        {
            _errorMessages = ["An unexpected error occurred while canceling sales order."];
        }
        finally
        {
            _isCanceling = false;
        }
    }
    
    public void Dispose()
    {
        _disposed = true;
        _searchVersion++;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = null;
    }
}