@page "/pos/new"
@rendermode InteractiveServer
@inject IPurchaseOrderService PurchaseOrderService
@inject ISupplierService SupplierService
@inject IInventoryService InventoryService
@inject IClock Clock

<h1>Add Purchase Order</h1>

<EditForm Model="_purchaseOrder" OnValidSubmit="HandleSubmit" FormName="AddPurchaseOrderForm">
    <FluentValidator />
    
    <div>
        <label>Invoice Number</label>
        <InputText @bind-Value="_purchaseOrder.InvoiceNumber" />
        <ValidationMessage For="@(() => _purchaseOrder.InvoiceNumber)" />
    </div>

    <div>
        <label>Supplier</label>
        
        <InputSearchableSelect
            TItem="GetSupplierDto"
            TValue="Guid?"
            @bind-Value="_purchaseOrder.SupplierId"
            Placeholder="Select a supplier"
            NullText="Select a supplier"
            AllowNull="true"
            PageSize="10"
            LoadItems="LoadSuppliers"
            GetValue="@(supplier => supplier.Id)"
            GetText="@(supplier => supplier.Name ?? string.Empty)" />
        
        <ValidationMessage For="@(() => _purchaseOrder.SupplierId)" />
    </div>

    <div>
        <label>Status</label>
        <InputSelect @bind-Value="_purchaseOrder.Status">
            <option value="">Select Status</option>
            <option value="@PurchaseOrderStatus.Pending">Pending</option>
            <option value="@PurchaseOrderStatus.ToOrder">To Order</option>
            <option value="@PurchaseOrderStatus.Ordered">Ordered</option>
            <option value="@PurchaseOrderStatus.InTransit">In Transit</option>
        </InputSelect>
        <ValidationMessage For="@(() => _purchaseOrder.Status)" />
    </div>

    <div>
        <label>Order Date</label>
        <InputDate @bind-Value="DateOrderedLocal"
                   Type="InputDateType.Date" />
        <ValidationMessage For="@(() => _purchaseOrder.DateOrdered)" />
    </div>

    <div>
        <label>Date Required</label>
        <InputDate @bind-Value="DateRequiredLocal"
                   Type="InputDateType.Date" />
        <ValidationMessage For="@(() => _purchaseOrder.DateRequired)" />
    </div>

    <hr />

    <h2>Purchase Order Details</h2>

    @for (int i = 0; i < _purchaseOrder.Details?.Count; i++)
    {
        int index = i;
        CreatePoDetailDto detail = _purchaseOrder.Details[index];

        <div class="po-detail" @key="detail">
            <h3>Detail @(index + 1)</h3>

            <div>
                <label>Item</label>
                
                <InputSearchableSelect
                    TItem="GetItemDto"
                    TValue="Guid?"
                    @bind-Value="detail.ItemId"
                    @bind-Value:after="() => HandleOnItemChange(detail)"
                    Placeholder="Select an item"
                    NullText="Select an item"
                    AllowNull="true"
                    PageSize="10"
                    LoadItems="LoadItems"
                    GetValue="@(item => item.Id)"
                    GetText="@(item => item.Name ?? string.Empty)" />
                
                <ValidationMessage For="@(() => detail.ItemId)" />
            </div>
            
            <div>
                <label>Unit Price</label>
                <InputNumber @bind-Value="detail.UnitPrice" />
                <ValidationMessage For="@(() => detail.UnitPrice)" />
            </div>

            <div>
                <label>Quantity</label>
                <InputNumber @bind-Value="detail.Quantity" />
                <ValidationMessage For="@(() => detail.Quantity)" />
            </div>

            @if (_purchaseOrder.Details.Count > 1)
            {
                <button type="button" @onclick="() => RemoveDetail(detail)">
                    Remove
                </button>
            }
        </div>
    }

    <button type="button" @onclick="AddDetail">
        +
    </button>

    <button type="submit">Submit</button>
</EditForm>

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success">
        @_successMessage
    </div>
}

@code {
    private readonly DateTimeZone _userTimeZone =
        DateTimeZoneProviders.Tzdb.GetSystemDefault();

    private CreatePurchaseOrderDto _purchaseOrder = new()
    {
        Status = PurchaseOrderStatus.Pending,
        Details = new()
        {
            new CreatePoDetailDto
            {
                PurchaseOrderId = Guid.Empty,
                LineSequence = 1
            }
        }
    };

    private string? _successMessage;

    private DateOnly? DateOrderedLocal
    {
        get => _purchaseOrder.DateOrdered?
            .InZone(_userTimeZone)
            .Date
            .ToDateOnly();

        set => _purchaseOrder.DateOrdered = value is null
            ? null
            : LocalDate.FromDateOnly(value.Value)
                .AtMidnight()
                .InZoneLeniently(_userTimeZone)
                .ToInstant();
    }

    private DateOnly? DateRequiredLocal
    {
        get => _purchaseOrder.DateRequired?
            .InZone(_userTimeZone)
            .Date
            .ToDateOnly();

        set => _purchaseOrder.DateRequired = value is null
            ? null
            : LocalDate.FromDateOnly(value.Value)
                .AtMidnight()
                .InZoneLeniently(_userTimeZone)
                .ToInstant();
    }

    protected override void OnInitialized()
    {
        _purchaseOrder.DateOrdered = Clock.GetCurrentInstant();
    }
    
    private async Task<InputSearchableSelect<GetSupplierDto, Guid?>.PagedResult<GetSupplierDto>>
        LoadSuppliers(
            string? query,
            int pageNumber,
            int pageSize,
            CancellationToken cancellationToken)
    {
        Result<GetManySuppliersDto> result =
            await SupplierService.GetManySuppliersAsync(
                query: query,
                pageNumber: pageNumber,
                pageSize: pageSize,
                cancellationToken: cancellationToken);

        if (!result.IsSuccess || result.Value is null)
        {
            return new()
            {
                Items = [],
                HasMore = false
            };
        }

        GetManySuppliersDto payload = result.Value;

        bool hasMore = payload.PageNumber * payload.PageSize < payload.TotalCount;

        return new()
        {
            Items = payload.Suppliers ?? [],
            HasMore = hasMore
        };
    }
    
    private async Task<InputSearchableSelect<GetItemDto, Guid?>.PagedResult<GetItemDto>>
        LoadItems(
            string? query,
            int pageNumber,
            int pageSize,
            CancellationToken cancellationToken)
    {
        Result<GetManyItemsDto> result =
            await InventoryService.GetManyItemsAsync(
                query: query,
                pageNumber: pageNumber,
                pageSize: pageSize,
                cancellationToken: cancellationToken);

        if (!result.IsSuccess || result.Value is null)
        {
            return new()
            {
                Items = [],
                HasMore = false
            };
        }

        GetManyItemsDto payload = result.Value;

        bool hasMore = payload.PageNumber * payload.PageSize < payload.TotalCount;

        return new()
        {
            Items = payload.Items ?? [],
            HasMore = hasMore
        };
    }

    private void AddDetail()
    {
        _purchaseOrder.Details?.Add(new CreatePoDetailDto
        {
            PurchaseOrderId = Guid.Empty,
            LineSequence = _purchaseOrder.Details.Count + 1
        });
    }

    private void RemoveDetail(CreatePoDetailDto detail)
    {
        if (_purchaseOrder.Details?.Count <= 1)
        {
            return;
        }

        _purchaseOrder.Details?.Remove(detail);
            
        for (int i = 0; i < _purchaseOrder.Details?.Count; i++)
        {
            _purchaseOrder.Details[i].LineSequence = i + 1;
        }
    }
    
    private async Task HandleOnItemChange(CreatePoDetailDto detail)
    {
        GetItemDto? item = (await InventoryService
            .GetItemByIdAsync(detail.ItemId ?? Guid.Empty)).Value;

        if (item != null)
        {
            detail.UnitPrice = item.CostPrice;
        }
    }

    private async Task HandleSubmit()
    {
        if (_purchaseOrder.Details?.Count <= 0)
        {
            return;
        }

        Result<GetPurchaseOrderDto> result = await PurchaseOrderService
            .CreatePurchaseOrderAsync(_purchaseOrder);

        if (result.IsSuccess)
        {
            _purchaseOrder = new()
            {
                Status = PurchaseOrderStatus.Pending,
                Details = new()
                {
                    new CreatePoDetailDto
                    {
                        PurchaseOrderId = Guid.Empty,
                        LineSequence = 1
                    }
                }
            };

            _purchaseOrder.DateOrdered = Clock.GetCurrentInstant();

            _successMessage = "Purchase Order successfully added";
        }
    }
}