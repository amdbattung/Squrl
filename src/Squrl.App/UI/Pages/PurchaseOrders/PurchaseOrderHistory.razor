@page "/pos/history"
@using SortDirection = Squrl.App.Enums.SortDirection
@rendermode InteractiveServer
@implements IDisposable
@inject IPurchaseOrderService PurchaseOrderService
@inject ISupplierService SupplierService
@inject NavigationManager Navigation

<h1>Purchase Orders</h1>

<input class="form-control"
       placeholder="Search invoice no..."
       value="@_searchInput"
       @oninput="OnSearchInput" />

<InputSearchableSelect
    TItem="GetSupplierDto"
    TValue="Guid?"
    @bind-Value="_supplierFilter"
    @bind-Value:after="HandleOnFiltersChange"
    Placeholder="Filter supplier"
    NullText="Select a supplier"
    AllowNull="true"
    PageSize="10"
    LoadItems="LoadSuppliers"
    GetValue="@(supplier => supplier.Id)"
    GetText="@(supplier => supplier.Name ?? string.Empty)" />

<div class="d-flex align-items-center gap-3 mb-3">
    <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               id="isPending"
               @bind="_isPendingFilter"
               @bind:after="HandleOnFiltersChange" />
        <label class="form-check-label" for="isPending">
            Pending
        </label>
    </div>

    <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               id="isReceived"
               @bind="_isReceivedFilter"
               @bind:after="HandleOnFiltersChange" />
        <label class="form-check-label" for="isReceived">
            Received
        </label>
    </div>
    
    <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               id="isCanceled"
               @bind="_isCanceledFilter"
               @bind:after="HandleOnFiltersChange" />
        <label class="form-check-label" for="isCanceled">
            Canceled
        </label>
    </div>
    
    <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               id="hasFailed"
               @bind="_hasFailedFilter"
               @bind:after="HandleOnFiltersChange" />
        <label class="form-check-label" for="hasFailed">
            Failed
        </label>
    </div>
    
    <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               id="isReturned"
               @bind="_isReturnedFilter"
               @bind:after="HandleOnFiltersChange" />
        <label class="form-check-label" for="isReturned">
            Returned
        </label>
    </div>
</div>

<QuickGrid @ref="_grid"
           TGridItem="GetPurchaseOrderDto"
           ItemsProvider="LoadPurchaseOrders"
           Pagination="@_pagination">
    <PropertyColumn Title="Purchase Order" Property="p => p.Id" />
    <PropertyColumn Title="Invoice" Property="p => p.InvoiceNumber" />
    <TemplateColumn Title="Supplier">
        @(_supplierCache.TryGetValue(context.SupplierId ?? Guid.Empty, out string? supplier)
            ? supplier
            : "")
    </TemplateColumn>
    <PropertyColumn Property="p => p.Status" />
    <TemplateColumn Title="Date Ordered">
        @context.DateOrdered?.InZone(_userTimeZone).Date.ToDateOnly().ToString("dd MMM yyyy")
    </TemplateColumn>
    <TemplateColumn Title="Date Required">
        @context.DateRequired?.InZone(_userTimeZone).Date.ToDateOnly().ToString("dd MMM yyyy")
    </TemplateColumn>
    <TemplateColumn Title="Date Shipped">
        @context.DateShipped?.InZone(_userTimeZone).Date.ToDateOnly().ToString("dd MMM yyyy")
    </TemplateColumn>
    <TemplateColumn Title="Actions">
        <button class="btn btn-secondary"
                @onclick="@(() => HandleEditPurchaseOrderButtonClick(context.Id ?? Guid.Empty))">
            Edit
        </button>
        <button class="btn btn-danger"
                disabled="@(_isDeleting)"
                @onclick="@(() => HandleDeletePurchaseOrderButtonClick(context.Id ?? Guid.Empty))">
            @(_isDeleting ? "Deleting..." : "Delete")
        </button>
    </TemplateColumn>
</QuickGrid>

<Paginator State="@_pagination" />

<select @bind="@_pagination.ItemsPerPage"> 
    <option>5</option> 
    <option>10</option> 
    <option>15</option> 
    <option>20</option> 
    <option>25</option> 
</select>

@if (_errorMessages.Count > 0)
{
    <div class="alert alert-danger mt-3" role="alert">
        <ul class="mb-0">
            @foreach (string error in _errorMessages)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@code {
    private QuickGrid<GetPurchaseOrderDto>? _grid;
    
    private readonly PaginationState _pagination = new()
    {
        ItemsPerPage = 10
    };
    
    private readonly Dictionary<Guid, string> _supplierCache = new();
    
    private readonly DateTimeZone _userTimeZone = DateTimeZoneProviders.Tzdb.GetSystemDefault();
    
    private string _searchInput = string.Empty;
    private string _search = string.Empty;

    private Guid? _supplierFilter;
    private bool _isReceivedFilter = true;
    private bool _isPendingFilter = true;
    private bool _isCanceledFilter = true;
    private bool _hasFailedFilter = true;
    private bool _isReturnedFilter = true;
    
    private readonly Debouncer _debouncer = new();
    
    private bool _isDeleting;
    private bool _disposed;
    
    private IReadOnlyList<string> _errorMessages = [];

    private async ValueTask<GridItemsProviderResult<GetPurchaseOrderDto>> LoadPurchaseOrders(
        GridItemsProviderRequest<GetPurchaseOrderDto> request)
    {
        try
        {
            int pageSize = request.Count ?? _pagination.ItemsPerPage;
            int pageNumber = request.StartIndex / pageSize + 1;

            Result<GetManyPurchaseOrdersDto> result =
                await PurchaseOrderService.GetManyPurchaseOrdersAsync(
                    _search,
                    _supplierFilter,
                    _isPendingFilter,
                    _isReceivedFilter,
                    _isCanceledFilter,
                    _hasFailedFilter,
                    _isReturnedFilter,
                    orderDirection: SortDirection.Descending,
                    pageNumber: pageNumber,
                    pageSize: pageSize,
                    cancellationToken: request.CancellationToken);

            if (!result.IsSuccess || result.Value?.PurchaseOrders is null)
            {
                _errorMessages = result.Errors;

                return GridItemsProviderResult.From(
                    Array.Empty<GetPurchaseOrderDto>(),
                    0);
            }
            
            foreach (GetPurchaseOrderDto purchaseOrder in result.Value.PurchaseOrders)
            {
                if (!_supplierCache.ContainsKey(purchaseOrder.SupplierId ?? Guid.Empty))
                {
                    Result<GetSupplierDto> supplier = await SupplierService
                        .GetSupplierByIdAsync(purchaseOrder.SupplierId ?? Guid.Empty);

                    if (supplier.IsSuccess)
                        _supplierCache[purchaseOrder.SupplierId ?? Guid.Empty] = supplier.Value?.Name ?? "";
                }
            }

            _errorMessages = [];

            return GridItemsProviderResult.From(
                result.Value.PurchaseOrders?.ToList() ?? [],
                result.Value.TotalCount);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            _errorMessages = ["An unexpected error occurred while loading purchase orders."];

            return GridItemsProviderResult.From(
                Array.Empty<GetPurchaseOrderDto>(),
                0);
        }
    }
    
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchInput = e.Value?.ToString() ?? string.Empty;

        await _debouncer.DebounceAsync(
            async cancellationToken =>
            {
                cancellationToken.ThrowIfCancellationRequested();
                await ApplyFiltersAsync();
            },
            TimeSpan.FromMilliseconds(500));
    }
    
    private async Task<InputSearchableSelect<GetSupplierDto, Guid?>.PagedResult<GetSupplierDto>>
        LoadSuppliers(
            string? query,
            int pageNumber,
            int pageSize,
            CancellationToken cancellationToken)
    {
        Result<GetManySuppliersDto> result =
            await SupplierService.GetManySuppliersAsync(
                query: query,
                pageNumber: pageNumber,
                pageSize: pageSize,
                cancellationToken: cancellationToken);

        if (!result.IsSuccess || result.Value?.Suppliers is null)
        {
            return new()
            {
                Items = [],
                HasMore = false
            };
        }

        GetManySuppliersDto payload = result.Value;

        bool hasMore = payload.PageNumber * payload.PageSize < payload.TotalCount;

        return new()
        {
            Items = payload.Suppliers ?? [],
            HasMore = hasMore
        };
    }
    
    private async Task HandleOnFiltersChange()
    {
        _debouncer.Cancel();

        await ApplyFiltersAsync();
    }
    
    private async Task ApplyFiltersAsync()
    {
        string newSearch = _searchInput.Trim();

        bool searchChanged = !string.Equals(
            _search,
            newSearch,
            StringComparison.Ordinal);

        if (!searchChanged && _grid is null)
        {
            return;
        }

        _search = newSearch;
        _errorMessages = [];

        if (_pagination.CurrentPageIndex != 0)
        {
            await _pagination.SetCurrentPageIndexAsync(0);
        }
        else if (_grid is not null)
        {
            await _grid.RefreshDataAsync();
        }
    }
    
    private void HandleEditPurchaseOrderButtonClick(Guid purchaseOrderId)
    {
        Navigation.NavigateTo($"/pos/{purchaseOrderId}/edit");
    }
    
    private async Task HandleDeletePurchaseOrderButtonClick(Guid purchaseOrderId)
    {
        if (_isDeleting)
        {
            return;
        }

        _isDeleting = true;
        _errorMessages = [];

        try
        {
            Result<GetPurchaseOrderDto> result = await PurchaseOrderService
                .DeletePurchaseOrderAsync(purchaseOrderId);

            if (!result.IsSuccess)
            {
                _errorMessages = result.Errors;
                return;
            }

            if (_grid is not null)
            {
                await _grid.RefreshDataAsync();
            }
        }
        catch (Exception)
        {
            _errorMessages = ["An unexpected error occurred while deleting purchase order."];
        }
        finally
        {
            _isDeleting = false;
        }
    }
    
    public void Dispose()
    {
        _disposed = true;
        _debouncer.Dispose();
    }
}