@page "/pos/{PurchaseOrderId:guid}/edit"
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject NavigationManager Navigation
@inject IPurchaseOrderService PurchaseOrderService
@inject ISupplierService SupplierService
@inject IInventoryService InventoryService

<h1>Edit Purchase Order</h1>

@if (PurchaseOrder is not null)
{
    <EditForm Model="PurchaseOrder" OnValidSubmit="HandleSubmit" FormName="EditPurchaseOrderForm">
        <FluentValidator />
        <div>
            <label>Invoice Number</label>
            <InputText @bind-Value="PurchaseOrder.InvoiceNumber" />
            <ValidationMessage For="@(() => PurchaseOrder.InvoiceNumber)" />
        </div>
        <div>
            <label>Supplier</label>
            
            <InputSearchableSelect
                TItem="GetSupplierDto"
                TValue="Guid?"
                @bind-Value="PurchaseOrder.SupplierId"
                InitialValueText="@_initialSupplierText"
                Placeholder="Select a supplier"
                NullText="Select a supplier"
                AllowNull="true"
                PageSize="10"
                LoadItems="LoadSuppliers"
                GetValue="@(supplier => supplier.Id)"
                GetText="@(supplier => supplier.Name ?? string.Empty)" />
            
            <ValidationMessage For="@(() => PurchaseOrder.SupplierId)" />
        </div>
        <div>
            <label>Status</label>
            <InputSelect @bind-Value="PurchaseOrder.Status">
                <option value="">Select Status</option>
                <option value="@PurchaseOrderStatus.Pending">Pending</option>
                <option value="@PurchaseOrderStatus.ToOrder">To Order</option>
                <option value="@PurchaseOrderStatus.Ordered">Ordered</option>
                <option value="@PurchaseOrderStatus.InTransit">In Transit</option>
                <option value="@PurchaseOrderStatus.Received">Received</option>
                <option value="@PurchaseOrderStatus.Cancelled">Cancelled</option>
                <option value="@PurchaseOrderStatus.Lost">Lost</option>
                <option value="@PurchaseOrderStatus.Failed">Failed</option>
                <option value="@PurchaseOrderStatus.Returned">Returned</option>
            </InputSelect>
            <ValidationMessage For="@(() => PurchaseOrder.Status)" />
        </div>
        <div>
            <label>Order Date</label>
            <InputDate @bind-Value="DateOrderedLocal"
                       Type="InputDateType.Date" />
            <ValidationMessage For="@(() => PurchaseOrder.DateOrdered)" />
        </div>
        <div>
            <label>Date Required</label>
            <InputDate @bind-Value="DateRequiredLocal"
                       Type="InputDateType.Date" />
            <ValidationMessage For="@(() => PurchaseOrder.DateRequired)" />
        </div>
        <div>
            <label>Date Shipped</label>
            <InputDate @bind-Value="DateShippedLocal"
                       Type="InputDateType.Date" />
            <ValidationMessage For="@(() => PurchaseOrder.DateShipped)" />
        </div>
        
        <hr />
        
        <h2>Purchase Order Details</h2>
        
        @if (PurchaseOrder.Details is not null)
        {
            @for (int i = 0; i < PurchaseOrder.Details.Count; i++)
            {
                int index = i;
                UpdatePoDetailDto detail = PurchaseOrder.Details[index];

                <div class="po-detail" @key="detail">
                    <h3>Detail @(index + 1)</h3>

                    <div>
                        <label>Item</label>
                        
                        <InputSearchableSelect
                            TItem="GetItemDto"
                            TValue="Guid?"
                            @bind-Value="detail.ItemId"
                            @bind-Value:after="() => HandleOnItemChange(detail)"
                            InitialValueText="@(_itemNameCache.TryGetValue(
                                                  detail.ItemId ?? Guid.Empty, out string? itemName)
                                                  ? itemName
                                                  : null)"
                            Placeholder="Select an item"
                            NullText="Select an item"
                            AllowNull="true"
                            PageSize="10"
                            LoadItems="LoadItems"
                            GetValue="@(item => item.Id)"
                            GetText="@(item => item.Name ?? string.Empty)" />
                
                        <ValidationMessage For="@(() => detail.ItemId)" />
                    </div>
                    
                    <div>
                        <label>Unit Price</label>
                        <InputNumber @bind-Value="detail.UnitPrice" />
                        <ValidationMessage For="@(() => detail.UnitPrice)" />
                    </div>

                    <div>
                        <label>Quantity</label>
                        <InputNumber @bind-Value="detail.Quantity" />
                        <ValidationMessage For="@(() => detail.Quantity)" />
                    </div>

                    @if (PurchaseOrder.Details.Count > 1)
                    {
                        <button type="button" @onclick="() => RemoveDetail(detail)">
                            Remove
                        </button>
                    }
                </div>
            }

            <button type="button" @onclick="AddDetail">
                +
            </button>
        }
        
        <button type="submit">Submit</button>
    </EditForm>
    
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">
            @_successMessage
        </div>
    }
}
else
{
    <p>Loading...</p>
}

@code {
    private string? _initialSupplierText;
    private readonly Dictionary<Guid, string> _itemNameCache = new();
    private readonly DateTimeZone _userTimeZone = DateTimeZoneProviders.Tzdb.GetSystemDefault();
    private string? _successMessage;
    
    [Parameter]
    public required Guid PurchaseOrderId { get; set; }
    
    [PersistentState]
    public UpdatePurchaseOrderDto? PurchaseOrder { get; set; }
    
    private DateOnly? DateOrderedLocal
    {
        get => PurchaseOrder?.DateOrdered?
            .InZone(_userTimeZone)
            .Date
            .ToDateOnly();

        set => PurchaseOrder?.DateOrdered = value is null
            ? null
            : LocalDate.FromDateOnly(value.Value)
                .AtMidnight()
                .InZoneLeniently(_userTimeZone)
                .ToInstant();
    }
    
    private DateOnly? DateRequiredLocal
    {
        get => PurchaseOrder?.DateRequired?
            .InZone(_userTimeZone)
            .Date
            .ToDateOnly();

        set => PurchaseOrder?.DateRequired = value is null
            ? null
            : LocalDate.FromDateOnly(value.Value)
                .AtMidnight()
                .InZoneLeniently(_userTimeZone)
                .ToInstant();
    }
    
    private DateOnly? DateShippedLocal
    {
        get => PurchaseOrder?.DateShipped?
            .InZone(_userTimeZone)
            .Date
            .ToDateOnly();

        set => PurchaseOrder?.DateShipped = value is null
            ? null
            : LocalDate.FromDateOnly(value.Value)
                .AtMidnight()
                .InZoneLeniently(_userTimeZone)
                .ToInstant();
    }
    
    protected override async Task OnInitializedAsync()
    {
        if (PurchaseOrder is null)
        {
            GetPurchaseOrderDto? purchaseOrderResult =
                (await PurchaseOrderService.GetPurchaseOrderByIdAsync(PurchaseOrderId)).Value;
            
            if (purchaseOrderResult is null)
            {
                Navigation.NotFound();
                return;
            }
            
            PurchaseOrder = new()
            {
                InvoiceNumber =  purchaseOrderResult.InvoiceNumber,
                SupplierId = purchaseOrderResult.SupplierId,
                Status = purchaseOrderResult.Status,
                DateOrdered = purchaseOrderResult.DateOrdered,
                DateRequired = purchaseOrderResult.DateRequired,
                DateShipped = purchaseOrderResult.DateShipped
            };
            
            GetSupplierDto? supplier = (await SupplierService
                .GetSupplierByIdAsync(purchaseOrderResult.SupplierId ?? Guid.Empty)).Value;
            if (supplier is not null)
            {
                _initialSupplierText = supplier.Name;
            }
        }
        
        if (PurchaseOrder is not null && PurchaseOrder.Details is null)
        {
            PurchaseOrder.Details = new List<UpdatePoDetailDto>();
            
            Result<GetManyPoDetailsDto> poDetailsResult = await PurchaseOrderService
                .GetPoDetailsAsync(PurchaseOrderId);

            foreach (GetPoDetailDto poDetail in poDetailsResult.Value?.PoDetails ?? Array.Empty<GetPoDetailDto>())
            {
                PurchaseOrder.Details.Add(new UpdatePoDetailDto
                {
                    PurchaseOrderId = Guid.Empty,
                    LineSequence =  poDetail.LineSequence,
                    ItemId = poDetail.ItemId,
                    UnitPrice =  poDetail.UnitPrice,
                    Quantity = poDetail.Quantity
                });
                
                if (!_itemNameCache.ContainsKey(poDetail.ItemId ?? Guid.Empty))
                {
                    Result<GetItemDto> item = await InventoryService
                        .GetItemByIdAsync(poDetail.ItemId ?? Guid.Empty);

                    if (item.IsSuccess)
                    {
                        _itemNameCache[poDetail.ItemId ?? Guid.Empty] = item.Value?.Name ?? string.Empty;
                    }
                }
            }
        }
    }
    
    private async Task<InputSearchableSelect<GetSupplierDto, Guid?>.PagedResult<GetSupplierDto>>
        LoadSuppliers(
            string? query,
            int pageNumber,
            int pageSize,
            CancellationToken cancellationToken)
    {
        Result<GetManySuppliersDto> result =
            await SupplierService.GetManySuppliersAsync(
                query: query,
                pageNumber: pageNumber,
                pageSize: pageSize,
                cancellationToken: cancellationToken);

        if (!result.IsSuccess || result.Value is null)
        {
            return new()
            {
                Items = [],
                HasMore = false
            };
        }

        GetManySuppliersDto payload = result.Value;

        bool hasMore = payload.PageNumber * payload.PageSize < payload.TotalCount;

        return new()
        {
            Items = payload.Suppliers ?? [],
            HasMore = hasMore
        };
    }
    
    private async Task<InputSearchableSelect<GetItemDto, Guid?>.PagedResult<GetItemDto>>
        LoadItems(
            string? query,
            int pageNumber,
            int pageSize,
            CancellationToken cancellationToken)
    {
        Result<GetManyItemsDto> result =
            await InventoryService.GetManyItemsAsync(
                query: query,
                pageNumber: pageNumber,
                pageSize: pageSize,
                cancellationToken: cancellationToken);

        if (!result.IsSuccess || result.Value is null)
        {
            return new()
            {
                Items = [],
                HasMore = false
            };
        }

        GetManyItemsDto payload = result.Value;

        bool hasMore = payload.PageNumber * payload.PageSize < payload.TotalCount;

        return new()
        {
            Items = payload.Items ?? [],
            HasMore = hasMore
        };
    }
    
    private void AddDetail()
    {
        if (PurchaseOrder?.Details is not null)
        {
            PurchaseOrder.Details.Add(new UpdatePoDetailDto
            {
                PurchaseOrderId = Guid.Empty,
                LineSequence = PurchaseOrder.Details.Count + 1,
            });
        }
    }

    private void RemoveDetail(UpdatePoDetailDto detail)
    {
        if (PurchaseOrder?.Details is not null)
        {
            if (PurchaseOrder.Details.Count <= 1)
            {
                return;
            }

            PurchaseOrder.Details.Remove(detail);
            
            for (int i = 0; i < PurchaseOrder.Details.Count; i++)
            {
                PurchaseOrder.Details[i].LineSequence = i + 1;
            }
        }
    }
    
    private async Task HandleOnItemChange(UpdatePoDetailDto detail)
    {
        GetItemDto? item = (await InventoryService
            .GetItemByIdAsync(detail.ItemId ?? Guid.Empty)).Value;

        if (item != null)
        {
            detail.UnitPrice = item.CostPrice;
        }
    }
    
    private async Task HandleSubmit()
    {
        if (PurchaseOrder is not null && PurchaseOrder.Details is not null)
        {
            Result<GetPurchaseOrderDto> result = await PurchaseOrderService
                .UpdatePurchaseOrderAsync(PurchaseOrderId, PurchaseOrder);

            if (result.IsSuccess)
            {
                _successMessage = $"Purchase order successfully updated";
            }
            else
            {
                _successMessage = null;
            }
        }
    }
}