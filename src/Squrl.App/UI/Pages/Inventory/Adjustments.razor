@page "/inventory/adjustments"
@rendermode InteractiveServer
@inject IInventoryService InventoryService

<h1>Adjust Item Stock</h1>

<EditForm Model="_adjustment" OnValidSubmit="HandleSubmit" FormName="AddItemForm">
    <FluentValidator />
    <div>
        <label>Item</label>
        <InputSearchableSelect
            TItem="GetItemDto"
            TValue="Guid?"
            @bind-Value="_adjustment.ItemId"
            @bind-Value:after="HandleOnItemChange"
            Placeholder="Select an item"
            NullText="Select an item"
            AllowNull="true"
            PageSize="10"
            LoadItems="LoadItems"
            GetValue="@(item => item.Id)"
            GetText="@(item => item.Name ?? string.Empty)" />

        <ValidationMessage For="@(() => _adjustment.ItemId)" />
    </div>
    <div>
        <label>Adjustment</label>
        <InputText @bind-Value="_adjustment.Adjustment" />
    </div>
    <p>Current Stock: @(_currentStock.HasValue
                          ? ToStringFormatters.FormatDecimal(_currentStock.Value)
                          : string.Empty)</p>
    <button type="submit">Submit</button>
</EditForm>

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success">
        @_successMessage
    </div>
}

@code {
    private decimal? _currentStock;
    private readonly StockAdjustmentFormModel _adjustment = new();
    private string? _successMessage;
    
    private async Task<InputSearchableSelect<GetItemDto, Guid?>.PagedResult<GetItemDto>>
        LoadItems(
            string? query,
            int pageNumber,
            int pageSize,
            CancellationToken cancellationToken)
    {
        Result<GetManyItemsDto> result =
            await InventoryService.GetManyItemsAsync(
                query: query,
                pageNumber: pageNumber,
                pageSize: pageSize,
                cancellationToken: cancellationToken);

        if (!result.IsSuccess || result.Value is null)
        {
            return new()
            {
                Items = [],
                HasMore = false
            };
        }

        GetManyItemsDto payload = result.Value;

        bool hasMore = payload.PageNumber * payload.PageSize < payload.TotalCount;

        return new()
        {
            Items = payload.Items ?? [],
            HasMore = hasMore
        };
    }
    
    private async Task HandleOnItemChange()
    {
        GetItemDto? item = (await InventoryService
            .GetItemByIdAsync(_adjustment.ItemId ?? Guid.Empty)).Value;
        
        _currentStock = item?.Quantity;
    }

    private async Task HandleSubmit()
    {
        Result<GetItemDto> result = await InventoryService.DynamicStockUpdateAsync(_adjustment.ItemId ?? Guid.Empty, _adjustment.Adjustment ?? "");
        
        if (result.IsSuccess)
        {
            _currentStock = result.Value?.Quantity;
            _adjustment.Adjustment = null;
            _successMessage = $"Item {result.Value?.Name} stock successfully adjusted";
        }
        else
        {
            _successMessage = null;
        }
    }
    
    private class StockAdjustmentFormModel
    {
        public Guid? ItemId { get; set; }
        public string? Adjustment { get; set; }
    }
}