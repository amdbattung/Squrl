@page "/settings"
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject ISettingsService SettingsService

<h1>Settings</h1>

@if (_userSettings is null)
{
    <p>Loading settings...</p>
}
else
{
    <EditForm Model="_userSettings" OnValidSubmit="HandleSubmit" FormName="SettingsForm">
        <FluentValidator />

        <div class="settings-form">

            <div class="mb-3">
                <label for="currencySymbol" class="form-label">
                    Currency Symbol
                </label>

                <InputText id="currencySymbol"
                           class="form-control"
                           @bind-Value="_userSettings.CurrencySymbol" />

                <ValidationMessage For="@(() => _userSettings.CurrencySymbol)" />
            </div>

            <div class="mb-3">
                <label for="quantityPrecision" class="form-label">
                    Item Quantity Precision
                </label>

                <InputNumber id="quantityPrecision"
                            class="form-control"
                            @bind-Value="_userSettings.ItemQuantityPrecision"
                            min="0"
                            max="6" />

                <ValidationMessage For="@(() => _userSettings.ItemQuantityPrecision)" />
            </div>

            <div class="form-check mb-3">
                <InputCheckbox id="openOnStartup"
                              class="form-check-input"
                              @bind-Value="_userSettings.OpenOnStartup" />

                <label for="openOnStartup" class="form-check-label">
                    Automatically open Squrl on start up
                </label>
            </div>

            <button type="submit" class="btn btn-primary">
                Save Settings
            </button>
        </div>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success mt-3">
            @_successMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger mt-3">
            @_errorMessage
        </div>
    }
}

@code {
    private SettingsFormModel? _userSettings;

    private string? _successMessage;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        UserSettings current = SettingsService.Current;

        _userSettings = new SettingsFormModel
        {
            CurrencySymbol = current.CurrencySymbol,
            ItemQuantityPrecision = current.ItemQuantityPrecision,
            OpenOnStartup = current.OpenOnStartup
        };
    }

    private async Task HandleSubmit()
    {
        if (_userSettings is null)
            return;

        UserSettings updatedSettings = new UserSettings
        {
            CurrencySymbol = _userSettings.CurrencySymbol,
            ItemQuantityPrecision = _userSettings.ItemQuantityPrecision,
            OpenOnStartup = _userSettings.OpenOnStartup
        };

        Result result = await SettingsService.UpdateAsync(updatedSettings);
        
        if (result.IsSuccess)
        {
            _successMessage = "Settings successfully updated";
        }
        else
        {
            _errorMessage = "Settings could not be updated";
            _successMessage = null;
        }
    }
    
    private sealed class SettingsFormModel
    {
        public string CurrencySymbol { get; set; } = "$";
        public int ItemQuantityPrecision { get; set; } = 2;
        public bool OpenOnStartup { get; set; }
    }
}